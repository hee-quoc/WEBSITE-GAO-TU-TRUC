// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique 
  image         String?
  hashedPassword String?  
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id              Int    @id @default(autoincrement())
  slug            String @unique
  title           String
  productImages   String[]
  tag             String[]
  description     String
  price           String
  detail          String
  properties      Int[]
  guide           Guide?
  package         String
  parts           String
  ingredients     String
  grow            String
  cooking         Cooking?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())   
  wrapProcess     String
  certificates    Certificate[]
  productCertImages String[]
}

model Guide {
  id        Int     @id @default(autoincrement())
  water     Float[]
  rice      String[]
  finger    String[]
  step      String[]
  product   Product @relation(fields: [productId], references: [id])
  productId Int     @unique
}

model Cooking {
  id          Int     @id @default(autoincrement())
  step        String[]
  description String
  product     Product @relation(fields: [productId], references: [id])
  productId   Int     @unique
}

model Certificate {
  id          Int     @id @default(autoincrement())
  name        String
  image       String
  description String
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
}


model Blog {
  title       String
  tag         String 
  slug        String   @unique
  content     String   @db.Text
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  thumbnailUrl String?
  contentImages BlogImage[]
}

model BlogImage {
  id      String @id @default(cuid())
  url     String 
  altText String? 
  blogId String
  blog   Blog   @relation(fields: [blogId], references: [slug], onDelete: Cascade)
  order Int? 
}